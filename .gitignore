# ==============================================================================
# MindMate / AdaptLearn - Git Ignore Rules
# ==============================================================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env
!.env.example
!.env.production.example

# Dependencies
node_modules/
**/node_modules/
venv/
**/venv/
__pycache__/
**/*.pyc
.pytest_cache/
**/.pytest_cache/

# Builds & compiled bundles
dist/
dist-ssr/
build/
.next/
coverage/

# Databases, backups & local state
*.db
*.db-*
*.db.bak
*.bak
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# Local uploaded files & document storage
storage/
**/storage/documents/*
!**/storage/documents/.gitkeep

# System & editor metadata
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/
.idea/

# ==============================================================================
# MindMate / AdaptLearn Backend Environment Variables
# ==============================================================================

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Cloud AI Provider Configuration
# Supported providers: gemini, openai, mock
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-2.5-flash

# Database & Persistence (SQLite local dev; PostgreSQL compatible)
DATABASE_URL="file:./dev.db"

# Session & Authentication Security
SESSION_SECRET="your_secure_session_secret_min_32_chars"

# API Keys (Set server-side only; never committed or exposed to the client)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

